  )
)


cat(
  sprintf(
    "b: %.6f\n",
    b
  )
)


cat(
  sprintf(
    "b^2: %.6f\n",
    b2
  )
)


cat(
  sprintf(
    "Liability -> observed scaling factor: %.6f\n",
    scale_factor
  )
)


# ======================================================================
# 19. PRINT LIABILITY-SCALE RESULTS
# ======================================================================

cat("\n")
cat("============================================================\n")
cat("LIABILITY-SCALE POSTERIOR RESULTS\n")
cat("============================================================\n\n")


print(
  round(
    liability_results,
